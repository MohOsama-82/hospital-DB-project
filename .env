# Add these to your existing .env file to enable outgoing email
# (patient welcome email + appointment confirmation email).
#
# If SMTP_HOST is left unset, the app just skips sending and logs a note -
# nothing breaks, patient creation and appointment acceptance still work.
#
# Example values below are for Gmail (using an "App Password", not your
# normal Gmail password - Google requires this for SMTP). Any SMTP provider
# works the same way: SendGrid, Mailgun, Amazon SES, your own mail server, etc.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM_EMAIL=youraddress@gmail.com
SMTP_FROM_NAME=Wardline Hospital